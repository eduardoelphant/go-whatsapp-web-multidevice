diff --git a/opus_mode.go b/opus_mode.go
new file mode 100644
index 0000000..113806a
--- /dev/null
+++ b/opus_mode.go
@@ -0,0 +1,82 @@
+package meowcaller
+
+import (
+	"os"
+
+	"github.com/purpshell/meowcaller/signaling"
+	"gopkg.in/hraban/opus.v2"
+)
+
+// Opus mode (spike patch): with MEOWCALLER_CODEC=opus the client stops advertising
+// capability 31 (use_mlow_codec_v1) and answers with voip_settings that turn MLow
+// off, so both sides fall back to standard Opus on the same PT120 / 16 kHz / 60 ms
+// RTP profile. Modelled on whatsapp-rust PR #1050 (wacore/src/stanza/call.rs).
+var opusMode = os.Getenv("MEOWCALLER_CODEC") == "opus"
+
+// opusVoipSettings is the accept-side override that stops the peer encoding MLow.
+var opusVoipSettings = []byte(`{"encode":{"use_mlow_codec_v1":"false"},"options":{"enable_48khz_rtp_clock":"false"}}`)
+
+func init() {
+	if !opusMode {
+		return
+	}
+	// Capability index 31 is bit 0x80 of byte 5.
+	signaling.CapabilityOffer[5] &^= 0x80
+	signaling.CapabilityVideoOffer[5] &^= 0x80
+	signaling.CapabilityPreaccept[5] &^= 0x80
+}
+
+type audioEncoder interface {
+	Encode(pcm []float32) ([]byte, error)
+}
+
+type opusEncoder struct {
+	enc *opus.Encoder
+	buf []byte
+}
+
+func newOpusEncoder() (*opusEncoder, error) {
+	enc, err := opus.NewEncoder(SampleRate, 1, opus.AppVoIP)
+	if err != nil {
+		return nil, err
+	}
+	if err := enc.SetBitrate(24000); err != nil {
+		return nil, err
+	}
+	if err := enc.SetComplexity(5); err != nil {
+		return nil, err
+	}
+	if err := enc.SetDTX(true); err != nil {
+		return nil, err
+	}
+	return &opusEncoder{enc: enc, buf: make([]byte, 1275)}, nil
+}
+
+func (o *opusEncoder) Encode(pcm []float32) ([]byte, error) {
+	n, err := o.enc.EncodeFloat32(pcm, o.buf)
+	if err != nil {
+		return nil, err
+	}
+	return append([]byte(nil), o.buf[:n]...), nil
+}
+
+type opusDecoder struct {
+	dec *opus.Decoder
+	buf []float32
+}
+
+func newOpusDecoder() (*opusDecoder, error) {
+	dec, err := opus.NewDecoder(SampleRate, 1)
+	if err != nil {
+		return nil, err
+	}
+	return &opusDecoder{dec: dec, buf: make([]float32, 1920)}, nil
+}
+
+func (o *opusDecoder) Decode(payload []byte) []float32 {
+	n, err := o.dec.DecodeFloat32(payload, o.buf)
+	if err != nil || n <= 0 {
+		return nil
+	}
+	return append([]float32(nil), o.buf[:n]...)
+}
diff --git a/opus_mode_test.go b/opus_mode_test.go
new file mode 100644
index 0000000..c4565a1
--- /dev/null
+++ b/opus_mode_test.go
@@ -0,0 +1,40 @@
+package meowcaller
+
+import "testing"
+
+func TestOpusRoundTrip(t *testing.T) {
+	enc, err := newOpusEncoder()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dec, err := newOpusDecoder()
+	if err != nil {
+		t.Fatal(err)
+	}
+	pcm := make([]float32, FrameSamples)
+	for i := range pcm {
+		pcm[i] = 0.3 * float32((i%40)-20) / 20
+	}
+	pkt, err := enc.Encode(pcm)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := dec.Decode(pkt)
+	if len(out) != FrameSamples {
+		t.Fatalf("decoded %d samples, want %d", len(out), FrameSamples)
+	}
+	t.Logf("packet %d bytes", len(pkt))
+}
+
+func BenchmarkOpusEncodeFrame(b *testing.B) {
+	enc, _ := newOpusEncoder()
+	pcm := make([]float32, FrameSamples)
+	for i := range pcm {
+		pcm[i] = 0.3 * float32((i%40)-20) / 20
+	}
+	for i := 0; i < b.N; i++ {
+		if _, err := enc.Encode(pcm); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
